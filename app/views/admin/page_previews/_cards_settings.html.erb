<div class="card-content-list">
  <div class="card-content-list__heading">
    <div><h3>Conteúdo e destino dos cards</h3><p>Configure imagem, texto e a página ou artigo que abre ao clicar.</p></div>
    <%= link_to "+ Adicionar card", new_admin_page_section_section_item_path(@page, section, kind: "card", from_preview: controller_name == "page_previews" ? "1" : nil), class: "admin-button-secondary", target: "_top" %>
  </div>
  <% section.section_items.cards.ordered.each do |item| %>
    <div class="card-content-list__item">
      <% if item.image.attached? %>
        <%= display_image_tag item.image, sizes: "80px", alt: "", class: "card-content-list__thumbnail" %>
      <% else %>
        <span class="card-content-list__placeholder" aria-hidden="true">▧</span>
      <% end %>
      <div><strong><%= item.title %></strong><small><%= item.video_available? ? "Com vídeo" : (item.image.attached? ? "Com imagem" : "Sem mídia") %> · <%= item.visible? ? "Visível" : "Oculto" %></small></div>
      <%= link_to "Editar card e destino", edit_admin_page_section_section_item_path(@page, section, item, from_preview: controller_name == "page_previews" ? "1" : nil), class: "admin-button-quiet", target: "_top" %>
    </div>
  <% end %>
</div>
<section class="preview-editor-group cards-settings" data-controller="cards-settings" data-cards-settings-section-id-value="<%= section.id %>">
  <header class="cards-settings__header"><div><h3>Layout dos cards por tela</h3><p>Escolha uma tela e ajuste seu formato, alinhamento e comportamento. Tablet e mobile podem herdar o desktop ou ter seus próprios valores.</p></div></header>
  <div class="device-appearance__selector" role="group" aria-label="Tela dos cards">
    <% {"desktop" => "Desktop", "tablet" => "Tablet", "mobile" => "Mobile"}.each do |device, label| %>
      <button type="button" data-device="<%= device %>" data-cards-settings-target="deviceButton" data-action="cards-settings#chooseDevice" aria-pressed="<%= device == 'desktop' %>"><%= label %></button>
    <% end %>
  </div>
  <div class="cards-settings__workspace">
    <div class="cards-settings__controls">
      <% {"desktop" => "Desktop", "tablet" => "Tablet", "mobile" => "Mobile"}.each do |device, label| %>
        <% base = device == "desktop"; scope = base ? f.object_name : "#{f.object_name}[responsive_settings][#{device}]" %>
        <div data-cards-settings-target="panel" data-device="<%= device %>" <%= 'hidden' unless base %>>
          <h4><%= label %></h4>
          <div class="cards-layout-selector">
            <% {"horizontal" => ["Horizontal", "Cards lado a lado"], "vertical" => ["Vertical", "Cards em uma coluna"]}.each do |value, (name, help)| %>
              <button type="button" class="cards-layout-choice" data-orientation="<%= value %>" data-action="cards-settings#orientationChanged" aria-pressed="false"><span class="cards-layout-choice__preview cards-layout-choice__preview--<%= value %>"><span></span><span></span><span></span></span><span class="cards-layout-choice__copy"><strong><%= name %></strong><small><%= help %></small></span><span class="cards-layout-choice__check">✓</span></button>
            <% end %>
          </div>
          <%= hidden_field_tag "#{scope}[cards_orientation]", base ? section.cards_orientation : section.responsive_settings.dig(device, 'cards_orientation'), data: { card_setting: 'orientation' } %>
          <div class="admin-section-editor__input-grid">
            <% {
              'cards_wrap' => ['Comportamento', [['Quebrar em novas linhas', 'true'], ['Carrossel quando não couber', 'false']], 'wrap'],
              'cards_alignment' => ['Alinhamento', [['Esquerda', 'left'], ['Centro', 'center'], ['Direita', 'right']], 'alignment'],
              'cards_placement' => ['Posição na seção', [['Depois do conteúdo', 'after'], ['Antes do conteúdo', 'before']], 'placement'],
              'cards_autoplay' => ['Avanço automático', [['Desligado', 'false'], ['Ligado', 'true']], 'autoplay']
            }.each do |field, (title, options, key)| %>
              <% id = "#{f.object_name}_#{section.id || 'new'}_#{device}_#{field}".gsub(/[^a-zA-Z0-9_-]/, '_') %>
              <div><%= label_tag id, "#{title} · #{label}" %><%= select_tag "#{scope}[#{field}]", options_for_select((base ? [] : [['Herdar Desktop', '']]) + options, (base ? section.public_send(field).to_s : section.responsive_settings.dig(device, field))), id: id, data: { card_setting: key, action: 'change->cards-settings#refresh' } %></div>
            <% end %>
            <div><%= f.label "cards_columns_#{device}", "Cards por linha · #{label}" %><%= f.select "cards_columns_#{device}", (1..(device == 'mobile' ? 2 : 4)).map { |n| ["#{n} #{n == 1 ? 'card' : 'cards'}", n] }, {}, data: { card_setting: 'columns', action: 'change->cards-settings#refresh' } %></div>
            <% interval_id = "cards_#{section.id || 'new'}_#{device}_seconds" %>
            <div><%= label_tag interval_id, "Intervalo (segundos) · #{label}" %><%= number_field_tag "#{scope}[cards_autoplay_seconds]", base ? section.cards_autoplay_seconds : section.responsive_settings.dig(device, 'cards_autoplay_seconds'), min: 2, max: 30, step: 1, placeholder: ("Herdar Desktop" unless base), id: interval_id, data: { card_setting: 'seconds', action: 'input->cards-settings#refresh' } %></div>
          </div>
          <% unless base %><button type="button" class="admin-button-quiet" data-action="cards-settings#inherit">Herdar formato e comportamento do Desktop</button><% end %>
          <p>“Cards por linha” vale para linhas com quebra. O carrossel mantém os cards compactos e só aparece quando eles excedem a largura da tela. No formato vertical, os cards ficam empilhados.</p>
        </div>
      <% end %>
    </div>
    <aside class="cards-settings__preview-column"><div class="cards-settings-preview"><header class="cards-settings-preview__header"><strong>Resultado aproximado</strong><span data-cards-settings-target="deviceLabel">Desktop</span></header><div class="cards-layout-preview" data-cards-settings-target="preview"><% 4.times do |index| %><article class="cards-layout-preview__card"><div class="cards-layout-preview__image"></div><div class="cards-layout-preview__content"><small><%= index + 1 %></small><strong></strong><span></span><span></span></div></article><% end %></div><p class="cards-settings-preview__help">A prévia acompanha somente a tela selecionada.</p></div></aside>
  </div>
</section>
