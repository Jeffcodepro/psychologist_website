<%
  dashboard_active =
    controller_name == "dashboard"

  pages_active =
    %w[
      pages
      page_previews
      sections
      section_items
    ].include?(controller_name) && !@page&.editorial?

  articles_active = controller_name == 'articles' || @page&.editorial?

  settings_active =
    controller_name == "site_settings"
%>

<header
  class="admin-navbar"
  data-controller="admin-navbar"
>

  <div class="admin-navbar__inner">

    <!-- ==================================================
         BRAND
    =================================================== -->

    <%= link_to(
          admin_root_path,
          class: "admin-navbar__brand"
        ) do %>

      <span class="admin-navbar__brand-mark <%= 'admin-navbar__brand-mark--photo' if @admin_site_setting&.profile_image&.attached? %>">
        <% if @admin_site_setting&.profile_image&.attached? %>
          <%= display_image_tag @admin_site_setting.profile_image, sizes: "48px", eager: true, alt: "Foto de #{@admin_site_setting.professional_name}", style: "object-position: #{@admin_site_setting.effective_profile_image_position_x}% #{@admin_site_setting.effective_profile_image_position_y}%; transform: scale(#{@admin_site_setting.effective_profile_image_zoom}); transform-origin: #{@admin_site_setting.effective_profile_image_position_x}% #{@admin_site_setting.effective_profile_image_position_y}%" %>
        <% else %>R<% end %>
      </span>

      <span class="admin-navbar__brand-copy">

        <strong>
          <%= @admin_site_setting&.professional_name.presence || "Rosemary" %> CMS
        </strong>

        <small>
          Gestão do site
        </small>

      </span>

    <% end %>


    <!-- ==================================================
         DESKTOP / TABLET NAVIGATION
    =================================================== -->

    <nav
      class="admin-navbar__navigation"
      aria-label="Navegação administrativa"
    >

      <%= link_to(
            admin_root_path,
            class: [
              "admin-navbar__link",
              dashboard_active ? "is-active" : nil
            ].compact.join(" ")
          ) do %>

        Visão geral

      <% end %>


      <%= link_to(
            admin_pages_path,
            class: [
              "admin-navbar__link",
              pages_active ? "is-active" : nil
            ].compact.join(" ")
          ) do %>

        Páginas

      <% end %>


      <%= link_to(
            edit_admin_site_setting_path,
            class: [
              "admin-navbar__link",
              settings_active ? "is-active" : nil
            ].compact.join(" ")
          ) do %>

        Configurações

      <% end %>

      <%= link_to "Mensagens", admin_contact_requests_path, class: "admin-navbar__link #{'is-active' if controller_name == 'contact_requests'}" %>
      <%= link_to 'Blog e textos', admin_articles_path, class: "admin-navbar__link #{'is-active' if articles_active}" %>
    </nav>


    <!-- ==================================================
         ACTIONS
    =================================================== -->

    <div class="admin-navbar__actions">
      <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "admin-button-quiet", form_class: "admin-navbar__logout" %>

      <%= link_to(
            cms_home_preview_path,
            class: "admin-navbar__view-site"
          ) do %>

        <span>
          Pré-visualizar
        </span>

        <span
          class="admin-navbar__external"
          aria-hidden="true"
        >
          ↗
        </span>

      <% end %>


      <button
        type="button"
        class="admin-navbar__menu-button"
        aria-label="Abrir menu"
        aria-expanded="false"
        data-admin-navbar-target="button"
        data-action="click->admin-navbar#toggle"
      >

        <span></span>
        <span></span>
        <span></span>

      </button>

    </div>

  </div>


  <!-- ==================================================
       MOBILE MENU
  =================================================== -->

  <div
    class="admin-navbar__mobile"
    data-admin-navbar-target="menu"
    hidden
  >

    <nav class="admin-navbar__mobile-links">

      <%= link_to(
            "Visão geral",
            admin_root_path,
            class: [
              "admin-navbar__mobile-link",
              dashboard_active ? "is-active" : nil
            ].compact.join(" ")
          ) %>


      <%= link_to(
            "Páginas",
            admin_pages_path,
            class: [
              "admin-navbar__mobile-link",
              pages_active ? "is-active" : nil
            ].compact.join(" ")
          ) %>


      <%= link_to(
            "Configurações",
            edit_admin_site_setting_path,
            class: [
              "admin-navbar__mobile-link",
              settings_active ? "is-active" : nil
            ].compact.join(" ")
          ) %>


      <%= link_to(
            "Pré-visualizar",
            cms_home_preview_path,
            class: "
              admin-navbar__mobile-link
              admin-navbar__mobile-link--site
            "
          ) %>

      <%= link_to "Mensagens", admin_contact_requests_path, class: "admin-navbar__mobile-link" %>
      <%= link_to 'Blog e textos', admin_articles_path, class: "admin-navbar__mobile-link #{'is-active' if articles_active}" %>
</nav>

  </div>

</header>
