<div class="admin-section-editor admin-item-editor" data-controller="translation" data-translation-url-value="<%= admin_translation_path %>">
  <div class="admin-breadcrumb"><%= link_to "Páginas", admin_pages_path %><span>/</span><%= link_to @page.name, admin_page_sections_path(@page) %><span>/</span><%= link_to @section.title.presence || "Bloco", edit_admin_page_section_path(@page, @section) %></div>
  <header class="admin-section-editor__heading"><div><span class="admin-page-eyebrow">Conteúdo da seção</span><h1><%= @section_item.persisted? ? "Editar #{@section_item.editor_label}" : "Adicionar #{@section_item.editor_label}" %></h1><p>Organize o texto e, se desejar, adicione uma imagem com seu próprio enquadramento.</p></div><span class="admin-section-editor__draft">Rascunho</span></header>
  <%= simple_form_for [:admin, @page, @section, @section_item], html: { class: "admin-section-editor__form" } do |f| %>
    <%= f.error_notification %>
    <%= f.hidden_field :item_kind %>
    <section class="admin-section-editor__panel is-active">
      <div class="admin-section-editor__panel-heading"><span>Conteúdo</span><h2><%= @section_item.item_kind == "question" ? "Pergunta e resposta" : "Texto do card" %></h2><p>Textos longos terão rolagem dentro do card, mantendo a mesma altura dos demais.</p></div>
      <%= f.input :title, label: @section_item.item_kind == "question" ? "Pergunta" : "Título", input_html: { data: { translation_target: "titlePt" } } %>
      <%= f.input :body, label: @section_item.item_kind == "question" ? "Resposta" : "Texto", input_html: { rows: 5, data: { translation_target: "bodyPt" } } %>
      <details class="admin-optional-fields"><summary>Versão em inglês (opcional)</summary>
        <button type="button" class="admin-button-secondary" data-translation-target="button" data-action="translation#translate">Traduzir com IA</button>
        <%= f.input :title_en, label: "Título em inglês", input_html: { data: { translation_target: "titleEn" } } %>
        <%= f.input :body_en, label: "Texto em inglês", input_html: { rows: 5, data: { translation_target: "bodyEn" } } %>
      </details>
      <% unless @section_item.item_kind == "question" %><%= render "admin/shared/image_cropper", f: f, record: @section_item, title: "Imagem opcional" %><% end %>
      <div class="admin-section-editor__input-grid"><%= f.input :position, label: "Ordem de exibição", input_html: { min: 0 } %><%= f.input :visible, as: :boolean, label: "Exibir este conteúdo" %></div>
    </section>
    <footer class="admin-section-editor__actions"><div class="admin-section-editor__actions-left"><%= link_to "Voltar ao bloco", edit_admin_page_section_path(@page, @section), class: "admin-button-quiet" %></div><div class="admin-section-editor__actions-right"><%= f.button :submit, "Salvar #{@section_item.editor_label}", class: "admin-button admin-button--primary" %></div></footer>
  <% end %>
</div>
