<% number = @site_setting&.whatsapp.to_s.gsub(/\D/, "") %>
<% if number.present? %>
  <%= link_to "https://wa.me/#{number}", class: "whatsapp-bubble", target: "_blank", rel: "noopener", aria: { label: I18n.locale == :en ? "Contact via WhatsApp" : "Falar pelo WhatsApp" } do %>
    <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
    <span>WhatsApp</span>
  <% end %>
<% end %>
