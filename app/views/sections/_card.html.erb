<article class="psychology-card compact-card <%= 'compact-card--with-image' if item.image.attached? %>" data-card-id="<%= item.id %>" style="<%= card_image_style(item) %>; <%= media_adjustment_style(item) %>">
  <% if item.image.attached? %>
    <div class="compact-card__media"><div class="compact-card__image-frame" data-shape="<%= item.image_shape %>">
      <%= image_tag item.image, alt: item.localized_title, class: "psychology-card__image compact-card__image", loading: "lazy" %>
    </div></div>
  <% end %>
  <div class="compact-card__content" tabindex="0" role="region" aria-label="<%= item.localized_title %>">
    <h3 class="compact-card__title"><%= item.localized_title %></h3>
    <% if item.localized_body.present? %><div class="compact-card__body"><%= simple_format(item.localized_body) %></div><% end %>
  </div>
</article>
