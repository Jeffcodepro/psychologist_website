<% english = I18n.locale == :en %>
<section class="appointment-section" id="agendamento" aria-labelledby="appointment-title">
  <div class="container appointment-section__layout">
    <div class="appointment-section__intro">
      <span class="appointment-section__eyebrow"><%= english ? "A first conversation" : "Uma primeira conversa" %></span>
      <h2 id="appointment-title"><%= english ? "Let’s find a time to talk." : "Vamos encontrar um momento para conversar." %></h2>
      <p><%= english ? "Leave your contact details and share what brings you here. I will get in touch to arrange a first conversation." : "Deixe seus contatos e conte o que trouxe você até aqui. Entrarei em contato para combinar uma primeira conversa." %></p>
      <p class="appointment-section__note"><%= english ? "Your information will only be used to respond to your request." : "Suas informações serão usadas apenas para responder ao seu contato." %></p>
    </div>
    <%= render "shared/contact_form", contact_request: ContactRequest.new, sent: false, preview: local_assigns[:preview] %>
  </div>
</section>
