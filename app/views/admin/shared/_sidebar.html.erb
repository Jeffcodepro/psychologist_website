<aside class="admin-sidebar">

  <div class="admin-sidebar__brand">

    <div class="admin-sidebar__brand-mark">
      R
    </div>

    <div>
      <strong>Rosemary</strong>
      <span>Content Manager</span>
    </div>

  </div>


  <nav class="admin-sidebar__navigation">

    <span class="admin-sidebar__label">
      Conteúdo
    </span>

    <%= link_to admin_root_path,
                class: "admin-sidebar__link" do %>
      <span class="admin-sidebar__icon">
        ◫
      </span>

      Visão geral
    <% end %>


    <% home_page = Page.find_by(slug: "home") %>

    <% if home_page.present? %>

      <%= link_to admin_page_sections_path(home_page),
                  class: "admin-sidebar__link" do %>

        <span class="admin-sidebar__icon">
          ▤
        </span>

        Página inicial

      <% end %>


      <%= link_to admin_page_preview_path(home_page),
                  class: "admin-sidebar__link",
                  target: "_blank" do %>

        <span class="admin-sidebar__icon">
          ◉
        </span>

        Pré-visualização

      <% end %>

    <% end %>


    <span class="admin-sidebar__label admin-sidebar__label--spacing">
      Site
    </span>


    <%= link_to edit_admin_site_setting_path,
                class: "admin-sidebar__link" do %>

      <span class="admin-sidebar__icon">
        ⚙
      </span>

      Configurações

    <% end %>

  </nav>


  <div class="admin-sidebar__footer">

    <div class="admin-sidebar__user">

      <div class="admin-sidebar__avatar">
        R
      </div>

      <div>
        <strong>Administrador</strong>

        <span>
          <%= current_user.email %>
        </span>
      </div>

    </div>

    <%= button_to destroy_user_session_path,
                  method: :delete,
                  class: "admin-sidebar__logout" do %>
      Sair
    <% end %>

  </div>

</aside>
