<div class="questions-list">
  <% section.visible_items("question").each do |item| %>
    <details class="question" name="questions-<%= section.id %>">
      <summary class="question__summary"><span><%= item.localized_title %></span><span class="question__toggle" aria-hidden="true"></span></summary>
      <div class="question__answer"><%= formatted_content(item.localized_body) %></div>
    </details>
  <% end %>
</div>
