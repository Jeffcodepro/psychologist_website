<%= simple_form_for(
      [:admin, page],
      url: (local_assigns[:form_url] || (page.persisted? ? admin_page_path(page) : admin_pages_path)),
      html: {
        class: "admin-page-form"
      }
    ) do |f| %>
  <%= f.error_notification %>

  <section class="admin-settings-section">
    <header class="admin-settings-section__header">
      <span class="admin-settings-section__number">
        01
      </span>

      <div>
        <h2>
          Identificação
        </h2>

        <p>
          Dê um nome à página. O endereço é criado automaticamente se ficar vazio.
        </p>
      </div>
    </header>

    <div class="admin-form-grid admin-form-grid--2">
      <% if page.editorial? || controller_name == 'articles' %>
        <%= f.input :content_kind, as: :select, collection: Page::EDITORIAL_KINDS, include_blank: false, label: 'Tipo de texto' %>
      <% end %>
      <%= f.input(
            :name,
            label: page.editorial? ? 'Título do texto' : 'Nome da página'
          ) %>

      <%= f.input(
            :slug,
            label: page.editorial? ? 'Endereço do texto (opcional)' : 'Endereço da página (opcional)',
            required: false,
            hint: "Ex.: psicoterapia. Se deixar vazio ao criar, usamos o nome da página."
          ) %>
    </div>

    <% if controller_name == 'articles' %>
      <% placement = ArticleCardService.new(article: page) %>
      <div class="admin-card-destination">
        <h3>Card na página Conteúdos</h3>
        <%= label_tag :card_section, 'Onde o card deve aparecer?' %>
        <%= select_tag :card_section, options_for_select([['Automático — Artigos ou Reflexões', '']] + placement.section_options, params[:card_section]) %>
        <p>O card será criado com o título e o resumo abaixo, já apontando para o texto completo. Depois, use “Card em Conteúdos” para ajustar sua imagem e apresentação.</p>
      </div>
    <% end %>
    <details class="admin-optional-fields" <%= 'open' if controller_name == 'articles' %>>
      <summary><%= controller_name == 'articles' ? 'Resumo para o card' : 'Descrições opcionais' %></summary>
      <p><%= controller_name == 'articles' ? 'Escreva uma apresentação curta ou deixe vazio para usar um trecho do texto automaticamente. O texto completo será produzido nos blocos, depois de criar o artigo.' : 'A descrição também serve como alternativa para as buscas quando a descrição SEO estiver vazia.' %></p>
    <div class="admin-form-grid admin-form-grid--2">
      <%= f.input(
            :description,
            as: :text,
            label: controller_name == 'articles' ? 'Resumo do card (opcional)' : 'Descrição da página (opcional)',
            input_html: {
              rows: 4
            }
          ) %>

      <%= f.input(
            :description_en,
            as: :text,
            label: "Descrição em inglês",
            input_html: {
              rows: 4
            }
          ) %>
    </div>
    </details>
  </section>

  <section class="admin-settings-section">
    <header class="admin-settings-section__header">
      <span class="admin-settings-section__number">
        02
      </span>

      <div>
        <h2>
          Menu do site
        </h2>

        <p>
          Controle como esta página aparece na navegação principal.
        </p>
      </div>
    </header>

    <div class="admin-form-grid admin-form-grid--2">
      <%= f.input(
            :nav_label,
            label: "Nome na menu"
          ) %>

      <%= f.input(
            :nav_label_en,
            label: "Nome na menu em inglês"
          ) %>

      <%= f.input(
            :position,
            label: "Posição"
          ) %>

      <%= f.input(
            :show_in_nav,
            as: :boolean,
            label: "Exibir na menu"
          ) %>
    </div>
  </section>

  <section class="admin-settings-section">
    <header class="admin-settings-section__header">
      <span class="admin-settings-section__number">
        03
      </span>

      <div>
        <h2>
          SEO
        </h2>

        <p>
          Como esta página aparece nos mecanismos de busca.
        </p>
      </div>
    </header>

    <div class="admin-form-grid admin-form-grid--2">
      <%= f.input(
            :seo_title,
            label: "Título SEO",
            hint: "Recomendado: até 60 caracteres."
          ) %>

      <%= f.input(
            :seo_title_en,
            label: "Título SEO em inglês",
            hint: "Recomendado: até 60 caracteres."
          ) %>
    </div>

    <div class="admin-form-grid admin-form-grid--2">
      <%= f.input(
            :seo_description,
            as: :text,
            label: "Descrição SEO",
            hint: "Recomendado: até 160 caracteres.",
            input_html: {
              rows: 4
            }
          ) %>

      <%= f.input(
            :seo_description_en,
            as: :text,
            label: "Descrição SEO em inglês",
            input_html: {
              rows: 4
            }
          ) %>
    </div>
  </section>

  <div class="admin-settings-actions">
    <%= link_to(
          "Cancelar",
          content_library_path(page),
          class: "admin-button-secondary"
        ) %>

    <%= f.button(
          :submit,
          page.editorial? ? 'Salvar texto' : 'Salvar página',
          class: "admin-button admin-button--primary"
        ) %>
  </div>
<% end %>
