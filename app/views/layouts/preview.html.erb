<!DOCTYPE html>

<html>
  <head>
    <title>Preview | <%= @page.name %></title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application",
                            "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body>

    <div class="admin-preview-bar">

      <strong>
        Pré-visualização do rascunho
      </strong>

      <div>
        <%= link_to "PT",
                    admin_page_preview_path(
                      @page,
                      locale: "pt-BR"
                    ) %>

        <%= link_to "EN",
                    admin_page_preview_path(
                      @page,
                      locale: "en"
                    ) %>

        <%= link_to "Voltar ao painel",
                    admin_page_sections_path(@page) %>

        <%= button_to "Aprovar e publicar",
                      admin_page_publication_path(@page),
                      method: :post,
                      data: {
                        turbo_confirm:
                          "Deseja publicar esta versão no site?"
                      } %>
      </div>

    </div>

    <%= render "shared/navbar" %>

    <%= yield %>

    <%= render "shared/footer" %>

  </body>
</html>
