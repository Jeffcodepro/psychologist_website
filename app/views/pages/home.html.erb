<% content_for :page_title do %>
  <%= @page.localized_seo_title %>
<% end %>

<% content_for :meta_description do %>
  <%= @page.localized_seo_description %>
<% end %>

<main class="public-page public-page--<%= @page.slug %>" data-controller="text-reveal">
  <% if @page.editorial? && @page.published_at.present? %>
    <div class="container article-publication-header"><%= render "shared/article_publication", page: @page %></div>
  <% end %>
  <% @sections.each do |section| %>
    <%= render "shared/section_render", section: section %>
  <% end %>
</main>
