<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:page_title) ? yield(:page_title) : (@site_setting&.professional_name.presence || "Rosemary Dias") %></title>
    <% if content_for?(:meta_description) %><meta name="description" content="<%= yield(:meta_description) %>"><% end %>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/navbar" %>

    <%= render "shared/flashes" %>

    <%= yield %>

    <%= render "shared/footer" %>
    <%= render "shared/whatsapp_bubble" %>
  </body>
</html>
