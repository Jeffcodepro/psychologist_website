# Variáveis não secretas para o formulário Environment variables do Portainer.
APP_IMAGE=psychologist-website:1.2.8
ACTIVE_STORAGE_SERVICE=cloudinary
APP_HOST=rosemarydias.com
TRAEFIK_PUBLIC_NETWORK=network_swarm_public
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencryptresolver
SMTP_USERNAME=rosemary.dias.psi@gmail.com
CONTACT_RECIPIENT=rosemary.dias.psi@gmail.com

# Nome do Docker Secret; não é a credencial.
CLOUDINARY_SECRET_NAME=psychologist_cloudinary_url_v1

# Preserve o nome do secret SMTP que já funciona na sua stack.
SMTP_SECRET_NAME=psychologist_smtp_password_v1
