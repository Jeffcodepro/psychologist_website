<% number = @site_setting&.whatsapp.to_s.gsub(/\D/, "") %>
<% if number.present? %>
  <%= link_to "https://wa.me/#{number}", class: "whatsapp-bubble", target: "_blank", rel: "noopener", aria: { label: I18n.locale == :en ? "Contact via WhatsApp" : "Falar pelo WhatsApp" } do %>
    <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M7.3 25.1 3.7 28.3 5 22.5a12 12 0 1 1 2.3 2.6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M11 9.5c-.8-.4-2 1.4-1.5 3.2 1 4.6 4 7.9 8.7 9.1 1.8.5 3.6-1.5 3-2.2l-2.5-2c-.5-.4-1.4.8-1.8 1-2.4-1-4.1-2.8-4.9-5 .2-.5 1.3-1.1.9-1.8L11 9.5Z" fill="currentColor"/></svg>
    <span>WhatsApp</span>
  <% end %>
<% end %>
