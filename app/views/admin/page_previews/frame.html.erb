<div class="preview-live-editor" data-controller="section-sort preview-editor"
     data-section-sort-url-value="<%= swap_positions_admin_page_sections_path(@page) %>">
  <%= render "shared/navbar" %>
  <main>
    <% @sections.each do |section| %>
      <div class="preview-editable-section" data-section-id="<%= section.id %>" data-action="dragover->section-sort#dragOver drop->section-sort#drop">
        <div class="preview-editable-section__toolbar">
          <button type="button" draggable="true" class="preview-drag-handle" data-section-id="<%= section.id %>" data-action="dragstart->section-sort#dragStart dragend->section-sort#dragEnd" aria-label="Mover seção inteira" title="Arraste para trocar a ordem das seções">⠿</button>
          <span class="preview-editable-section__name"><%= section.editor_type_label %></span>
          <button type="button" class="preview-edit-button" data-panel-id="preview-editor-<%= section.id %>" data-action="preview-editor#open">Editar seção</button>
        </div>
        <div class="preview-section-content" data-preview-section-id="<%= section.id %>"><%= render "shared/section_render", section: section %></div>
      </div>
    <% end %>
  </main>
  <%= render "shared/footer" %>
  <%= render "shared/whatsapp_bubble" %>
  <div class="preview-editor-backdrop" data-preview-editor-target="backdrop" data-action="preview-editor#close" hidden></div>
  <% @sections.each do |section| %>
    <aside id="preview-editor-<%= section.id %>" class="preview-editor-drawer" data-preview-editor-target="panel" hidden><%= render "section_editor", section: section %></aside>
  <% end %>
</div>
