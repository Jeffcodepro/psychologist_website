<span class="auth-eyebrow">Recuperação de acesso</span>
<h2>Crie uma nova senha.</h2>
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>
  <div class="auth-field"><%= f.label :password, "Nova senha" %><%= f.password_field :password, required: true, minlength: 12, autocomplete: "new-password" %><small>Use pelo menos 12 caracteres.</small></div>
  <div class="auth-field"><%= f.label :password_confirmation, "Confirme a nova senha" %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
  <%= f.submit "Salvar nova senha", class: "auth-submit" %>
<% end %>
<div class="auth-links"><%= link_to "Voltar ao login", new_session_path(resource_name) %></div>
