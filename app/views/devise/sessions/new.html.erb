<span class="auth-eyebrow">Acesso administrativo</span>
<h2><%= @login_tenant.name %></h2>
<p>Entre com sua conta para gerenciar o site.</p>
<%= form_for(resource, as: resource_name, url: user_session_path(access_key: params[:access_key]), html: { class: "auth-form" }) do |f| %>
  <div class="auth-field"><%= f.label :email, "E-mail" %><%= f.email_field :email, required: true, autofocus: true, autocomplete: "username" %></div>
  <div class="auth-field"><%= f.label :password, "Senha" %><%= f.password_field :password, required: true, autocomplete: "current-password" %></div>
  <%= f.submit "Entrar no painel", class: "auth-submit", data: { turbo_submits_with: "Entrando…" } %>
<% end %>
<div class="auth-links"><%= link_to "Esqueci minha senha", new_user_password_path(access_key: params[:access_key]) %></div>
