<section class="site-section gallery-section">
  <div class="container">

    <% if section.localized_title.present? %>
      <h2><%= section.localized_title %></h2>
    <% end %>

    <% if section.localized_body.present? %>
      <%= simple_format(section.localized_body) %>
    <% end %>

    <div class="gallery-grid">
      <% section.section_items.where(visible: true).order(:position).each do |item| %>

        <% if item.image.attached? %>
          <figure>

            <%= image_tag item.image,
                          alt: item.localized_title,
                          class: "img-fluid" %>

            <% if item.localized_title.present? %>
              <figcaption>
                <%= item.localized_title %>
              </figcaption>
            <% end %>

          </figure>
        <% end %>

      <% end %>
    </div>

  </div>
</section>
