<%
  items = section
    .section_items
    .visible
    .ordered

  alignment =
    section.text_alignment.presence || "left"
%>

<section
  class="faq-section"
  id="<%= section.anchor if section.anchor.present? %>"
>
  <div class="container faq-section__container">
    <header
      class="
        faq-section__header
        section-alignment--<%= alignment %>
      "
    >
      <% if section.localized_title.present? %>
        <h2 class="faq-section__title">
          <%= section.localized_title %>
        </h2>
      <% end %>

      <% if section.localized_body.present? %>
        <div class="faq-section__intro">
          <%= simple_format(section.localized_body) %>
        </div>
      <% end %>
    </header>

    <% if items.any? %>
      <div class="faq-section__items">
        <% items.each_with_index do |item, index| %>
          <details class="faq-item">
            <summary class="faq-item__question">
              <span class="faq-item__number">
                <%= format("%02d", index + 1) %>
              </span>

              <span class="faq-item__question-text">
                <%= item.localized_title %>
              </span>

              <span
                class="faq-item__icon"
                aria-hidden="true"
              >
                +
              </span>
            </summary>

            <% if item.localized_body.present? %>
              <div class="faq-item__answer">
                <div class="faq-item__answer-inner">
                  <%= simple_format(item.localized_body) %>
                </div>
              </div>
            <% end %>
          </details>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
