<div class="gallery-grid">
  <% section.visible_items("gallery").each do |item| %>
    <% if item.image.attached? %>
      <figure><%= display_image_tag item.image, alt: item.localized_title, loading: "lazy", class: "img-fluid" %><figcaption><%= item.localized_title %></figcaption></figure>
    <% end %>
  <% end %>
</div>
