<% return_path = local_assigns[:return_to].presence || (section.persisted? ? edit_admin_page_section_path(page, section) : admin_page_sections_path(page)) %>
<article class="admin-section-editor__card">
  <%= f.input :media_interval_seconds, label: "Tempo entre imagens (segundos)", input_html: { min: 2, max: 30 }, hint: "Com duas ou mais imagens, a troca é automática, sem setas laterais. Quem visita pode pausar a sequência." %>
</article>
<% [["banner", "Banner ou imagem de fundo"], ["image", "Fotografia do conteúdo"]].each do |role, label| %>
  <article class="admin-section-editor__card media-library" data-controller="media-library" data-media-library-token-value="NEW_SLIDE_<%= role.upcase %>">
    <h3><%= label %></h3>
    <% if role == "banner" %>
      <div class="admin-section-editor__input-grid">
        <%= f.input :banner_layout, collection: [["Faixa acima", "top"], ["Imagem de fundo", "background"], ["Faixa abaixo", "bottom"]], label: "Onde exibir o banner", include_blank: false %>
      </div>
    <% else %>
      <label class="cms-toggle">
        <%= f.check_box :use_profile_image %>
        <span><strong>Usar a foto profissional nesta seção</strong><small>Opcional. Quando desativado, só aparecem as imagens que você adicionar aqui.</small></span>
      </label>
    <% end %>
    <%= render "admin/sections/media_overlay", f: f, section: section, role: role %>
    <div data-media-library-target="primary"><%= render "admin/shared/image_cropper", f: f, record: section, media: role, title: role == "banner" ? "Banner principal" : "Fotografia principal" %></div>
    <% if section.persisted? && section.public_send(role).attached? %>
      <%= f.hidden_field "remove_#{role}", value: "0", data: { media_library_target: "removeFlag" } %>
      <button type="button" class="media-remove-button" data-media-library-target="removeButton" data-action="media-library#removePrimary" data-label="<%= role == 'banner' ? 'Remover este banner' : 'Remover esta fotografia' %>"><%= role == 'banner' ? 'Remover este banner' : 'Remover esta fotografia' %></button>
      <p class="media-library__removal-note" data-media-library-target="removeNote" hidden>A imagem será removida ao salvar. As imagens adicionais serão mantidas.</p>
    <% end %>
    <div data-media-library-target="list">
      <%= f.simple_fields_for :section_slides, section.section_slides.select { |slide| slide.role == role } do |slide_form| %>
        <%= render "admin/sections/media_slide", f: slide_form, role: role %>
      <% end %>
    </div>
    <template data-media-library-target="template">
      <%= f.simple_fields_for :section_slides, SectionSlide.new(role: role, image_shape: section.image_shape), child_index: "NEW_SLIDE_#{role.upcase}" do |slide_form| %>
        <%= render "admin/sections/media_slide", f: slide_form, role: role %>
      <% end %>
    </template>
    <button type="button" class="admin-button-secondary" data-action="media-library#add">+ <%= role == "banner" ? "Adicionar outro banner" : "Adicionar outra fotografia" %></button>
  </article>
<% end %>
