<article class="admin-section-editor__card button-designer" data-controller="button-designer">
  <h3><%= heading %></h3>
  <%= f.hidden_field field, data: { button_designer_target: 'value' } %>
  <div data-button-designer-target="list" class="button-designer__list"></div>
  <button type="button" class="admin-button-secondary" data-action="button-designer#add">+ Adicionar botão</button>
  <span data-button-designer-target="status" role="status"></span>
  <template data-button-designer-target="template">
    <div class="button-designer__item" data-button-row data-controller="translation" data-translation-url-value="<%= admin_translation_path %>">
      <div class="button-designer__toolbar"><button type="button" draggable="true" class="button-designer__handle" aria-label="Arrastar botão" data-action="dragstart->button-designer#start dragend->button-designer#end">⠿</button><strong data-heading></strong><div class="button-designer__tools"><button type="button" data-action="button-designer#up" aria-label="Mover botão para cima">↑</button><button type="button" data-action="button-designer#down" aria-label="Mover botão para baixo">↓</button><button type="button" class="button-designer__delete" data-action="button-designer#remove">Excluir</button></div></div>
      <div class="button-designer__body" data-action="input->button-designer#update change->button-designer#update">
        <div class="button-designer__content">
          <label>Texto <input data-property="label" data-translation-target="textPt" required maxlength="80"></label>
          <label>Ação <select data-property="action"><%= options_for_select(ActionButtonSchema::ACTIONS) %></select></label>
          <label data-destination-row>Destino <input data-property="value" maxlength="1000" placeholder="https://exemplo.com"></label>
          <label data-section-row hidden>Seção <select data-property="section_value"><option value="">Selecione a página e a seção</option><%= options_for_select(button_destination_sections) %></select></label>
          <label data-page-row hidden>Página <select data-property="page_value"><option value="">Selecione</option><%= options_for_select(current_tenant.pages.ordered.map { |page| [page.name, page.id] }) %></select></label>
          <details class="button-designer__translation"><summary>Texto em inglês</summary>
            <label>Texto em inglês <input data-property="label_en" data-translation-target="textEn" maxlength="80"></label>
            <button type="button" class="admin-button-secondary" data-action="translation#translate" data-translation-target="button">Traduzir com IA</button>
            <div class="section-translation-feedback" data-translation-target="status" role="status" hidden></div>
          </details>
        </div>
        <div class="button-designer__appearance">
          <div class="button-designer__sample"><span data-button-sample>Saiba mais</span></div>
          <label>Estilo <select data-property="style"><option value="primary">Destaque</option><option value="secondary">Contorno</option><option value="custom">Personalizado</option></select></label>
          <div class="button-designer__pair">
            <label>Tamanho <select data-property="size"><option value="medium">Médio</option><option value="small">Pequeno</option><option value="large">Grande</option></select></label>
            <label>Formato <select data-property="shape"><option value="pill">Pílula</option><option value="rounded">Arredondado</option><option value="square">Retangular</option></select></label>
          </div>
          <div class="button-designer__pair">
            <% { "background_color" => ["Cor do botão", "#2b493b"], "text_color" => ["Cor do texto", "#ffffff"] }.each do |property, (label, color)| %>
              <label data-custom-color hidden><%= label %><span class="button-designer__color"><input type="color" data-property="<%= property %>" value="<%= color %>"><output data-color-value="<%= property %>"><%= color %></output></span></label>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </template>
</article>
