<% Array(buttons).each do |button| %>
  <% destination = configured_button_path(button); next if destination.blank? %>
  <% label = I18n.locale == :en ? button['label_en'].presence || button['label'] : button['label'] %>
  <%= link_to label, destination, class: "site-action site-action--#{button['style']} site-action--#{button['size'].presence || 'medium'} site-action--#{button['shape'].presence || 'pill'} #{local_assigns[:button_class]}", style: configured_button_style(button), target: %w[url whatsapp].include?(button['action']) ? '_blank' : (cms_preview? && !destination.start_with?('#') ? '_top' : nil), rel: %w[url whatsapp].include?(button['action']) ? 'noopener noreferrer' : nil %>
<% end %>
