<%
  professional_name =
    @site_setting&.professional_name.presence ||
      "Rosemary Dias"

  crp =
    @site_setting&.crp.presence

  email =
    @site_setting&.email.presence

  phone =
    @site_setting&.phone.presence

  whatsapp_number =
    @site_setting&.whatsapp
      .to_s
      .gsub(/\D/, "")

  social_links = social_profiles(@site_setting)

  footer_text =
    @site_setting&.localized_footer_text.presence

  preview_frame =
    request.path.include?("/preview/frame")

  demo_contacts = @site_setting&.demo_contacts?
  contact_available = demo_contacts || [email, phone, whatsapp_number.presence].any?(&:present?) || social_links.any?

  footer_default_text =
    I18n.locale == :en ?
      "Psychology, communication and human development." :
      "Psicologia, comunicação e desenvolvimento humano."
%>

<footer
  class="site-footer"
  id="rodape"
>

  <div class="container site-footer__container">

    <!-- ==========================================
         TOP
    =========================================== -->

    <div class="site-footer__top <%= "site-footer__top--without-contact" unless contact_available %>">

      <!-- BRAND -->

      <div class="site-footer__brand">

        <% if @site_setting&.logo&.attached? %>

          <%= display_image_tag(
                @site_setting.logo,
                profile: :logo, sizes: "128px",
                alt: professional_name,
                class: "site-footer__logo"
              ) %>

        <% end %>

          <span class="site-footer__brand-name">
            <%= professional_name %>
          </span>

          <span class="site-footer__brand-subtitle">
            <%= I18n.locale == :en ?
                  "Psychology & Human Development" :
                  "Psicologia & Desenvolvimento Humano" %>
          </span>




        <p class="site-footer__description">
          <%= footer_text || footer_default_text %>
        </p>


        <div class="site-footer__configured-actions"><%= render "shared/action_buttons", buttons: @site_setting&.footer_actions %></div>

      </div>


      <!-- NAVIGATION -->

      <div class="site-footer__group">

        <span class="site-footer__group-title">
          <%= I18n.locale == :en ?
                "Navigation" :
                "Navegação" %>
        </span>

        <nav class="site-footer__links" aria-label="<%= I18n.locale == :en ? 'Footer navigation' : 'Navegação do rodapé' %>">
          <% Array(@navigation_pages).each do |page| %>
            <% destination = if preview_frame
              admin_page_preview_path(page, locale: I18n.locale)
            elsif page.home?
              root_path
            else
              public_page_path(slug: page.slug)
            end %>
            <%= link_to page.localized_nav_label, destination, target: preview_frame ? "_top" : nil %>
          <% end %>
        </nav>

      </div>


      <!-- CONTACT + SOCIAL -->

      <% if contact_available %>
      <div class="site-footer__group">

        <span class="site-footer__group-title">
          <%= I18n.locale == :en ?
                "Contact" :
                "Contato" %>
        </span>

        <div class="site-footer__links">
          <% if demo_contacts && (email.blank? || phone.blank?) %>
            <small class="site-footer__demo-label"><%= I18n.locale == :en ? "Sample contacts" : "Contatos de demonstração" %></small>
            <% if email.blank? %><span class="site-footer__contact-link">contato@example.com</span><% end %>
            <% if phone.blank? %><span class="site-footer__contact-link">(11) 00000-0000</span><% end %>
            <span class="site-footer__contact-link"><%= I18n.locale == :en ? "Online and in-person sessions" : "Atendimento online e presencial" %></span>
          <% end %>

          <% if email.present? %>

            <%= mail_to(
                  email,
                  email,
                  class: "site-footer__contact-link"
                ) %>

          <% end %>


          <% if phone.present? %>

            <%= link_to(
                  phone,
                  "tel:#{phone.gsub(/\D/, '')}",
                  class: "site-footer__contact-link"
                ) %>

          <% end %>


          <% if whatsapp_number.present? %>

            <%= link_to "https://wa.me/#{whatsapp_number}", target: "_blank", rel: "noopener noreferrer", class: "site-footer__contact-link site-footer__social-link" do %>
              <i class="fa-brands fa-whatsapp fa-fw" aria-hidden="true"></i>
              <span>WhatsApp</span>
            <% end %>

          <% end %>


          <% social_links.each do |profile| %>
            <%= link_to profile[:url], target: "_blank", rel: "noopener noreferrer", class: "site-footer__social-link" do %>
              <i class="fa-brands fa-<%= profile[:icon] %> fa-fw" aria-hidden="true"></i>
              <span><%= profile[:label] %></span>
            <% end %>
          <% end %>

        </div>

      </div>

      <% end %>
    </div>


    <!-- ==========================================
         PROFESSIONAL ROW
    =========================================== -->

    <div class="site-footer__middle">

      <div class="site-footer__professional">

        <strong>
          <%= professional_name %>
        </strong>

        <span class="site-footer__dot"></span>

        <span>
          <%= I18n.locale == :en ?
                "Psychologist" :
                "Psicóloga" %>
        </span>

        <% if crp.present? %>

          <span class="site-footer__dot"></span>

          <span>
            CRP <%= crp %>
          </span>

        <% end %>

      </div>


      <div class="site-footer__languages">

        <%= render "shared/language_control", language: "pt-BR", css_class: "site-footer__language" %>

        <span>
          /
        </span>

        <%= render "shared/language_control", language: "en", css_class: "site-footer__language" %>

      </div>

    </div>


    <!-- ==========================================
         BOTTOM
    =========================================== -->

    <div class="site-footer__bottom">

      <span>
        © <%= Time.current.year %>
        <%= professional_name %>.
      </span>

      <span>
        <%= I18n.locale == :en ?
              "All rights reserved." :
              "Todos os direitos reservados." %>
      </span>

    </div>

  </div>

</footer>
