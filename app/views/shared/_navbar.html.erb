<%
  professional_name =
    @site_setting&.professional_name.presence || "Rosemary Dias"

  preview_frame =
    request.path.include?("/admin/pages/") &&
    request.path.include?("/preview/frame")

  current_locale = I18n.locale.to_s

  current_page =
    @page

  navigation_pages =
    Array(@navigation_pages)

  logo_zoom =
    if @site_setting&.respond_to?(:effective_logo_zoom)
      @site_setting.effective_logo_zoom
    else
      1.0
    end

  logo_x =
    if @site_setting&.respond_to?(:effective_logo_position_x)
      @site_setting.effective_logo_position_x
    else
      50
    end

  logo_y =
    if @site_setting&.respond_to?(:effective_logo_position_y)
      @site_setting.effective_logo_position_y
    else
      50
    end

  whatsapp_number =
    @site_setting&.whatsapp.to_s.gsub(/\D/, "")


  public_path_for = lambda do |page|
    if page.home?
      root_path
    else
      public_page_path(slug: page.slug)
    end
  end

  preview_path_for = lambda do |page|
    admin_page_preview_path(
      page
    )
  end

  brand_page =
    navigation_pages.find(&:home?)

  brand_path =
    if preview_frame
      brand_page ? preview_path_for.call(brand_page) : admin_root_path
    else
      root_path
    end

%>

<header
  class="site-navbar"
  data-controller="site-navbar"
>
  <div class="container site-navbar__container">
    <% if @site_setting&.logo&.attached? %>
      <div class="site-navbar__brand" data-controller="logo-link">
        <span class="site-navbar__logo-frame" data-logo-link-target="frame"
          style="--site-logo-zoom: <%= logo_zoom %>; --site-logo-x: <%= logo_x %>%; --site-logo-y: <%= logo_y %>%;">
          <%= display_image_tag @site_setting.logo, profile: :logo, sizes: "220px", eager: true,
                alt: "", class: "site-navbar__logo", data: { logo_link_target: "image", action: "load->logo-link#resize" } %>
          <%= link_to brand_path, class: "site-navbar__logo-link", target: preview_frame ? "_top" : nil,
                aria: { label: "#{professional_name} — #{I18n.locale == :en ? 'Home' : 'Página inicial'}" },
                data: { logo_link_target: "link" } do %>
            <span class="visually-hidden"><%= professional_name %></span>
          <% end %>
        </span>
      </div>
    <% else %>
      <%= link_to brand_path, class: "site-navbar__brand", target: preview_frame ? "_top" : nil do %>
        <span class="site-navbar__brand-copy"><strong><%= professional_name %></strong>
          <small><%= I18n.locale == :en ? "Psychology & Human Development" : "Psicologia & Desenvolvimento Humano" %></small>
        </span>
      <% end %>
    <% end %>

    <nav
      class="site-navbar__navigation"
      aria-label="Navegação principal"
    >
      <% navigation_pages.each do |page| %>
        <%
          page_path =
            if preview_frame
              preview_path_for.call(page)
            else
              public_path_for.call(page)
            end
        %>

        <%= link_to(
              page.localized_nav_label,
              page_path,
              target: preview_frame ? "_top" : nil,
              class: [
                "site-navbar__link",
                current_page&.id == page.id ? "is-active" : nil
              ].compact.join(" ")
            ) %>
      <% end %>
    </nav>

    <div class="site-navbar__actions">
      <div class="site-navbar__languages">
        <%= render "shared/language_control", language: "pt-BR", css_class: "site-navbar__language" %>

        <%= render "shared/language_control", language: "en", css_class: "site-navbar__language" %>
      </div>

      <div class="site-navbar__configured-actions"><%= render "shared/action_buttons", buttons: @site_setting&.header_actions %></div>

      <button
        type="button"
        class="site-navbar__menu-button"
        aria-label="Abrir menu"
        aria-expanded="false"
        data-site-navbar-target="button"
        data-action="click->site-navbar#toggle"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div
    class="site-navbar__mobile-backdrop"
    data-site-navbar-target="backdrop"
    data-action="click->site-navbar#close"
    hidden
  ></div>

  <aside
    class="site-navbar__mobile-menu"
    data-site-navbar-target="menu"
    hidden
  >
    <div class="site-navbar__mobile-header">
      <strong>
        <%= professional_name %>
      </strong>

      <button
        type="button"
        class="site-navbar__mobile-close"
        aria-label="Fechar menu"
        data-action="click->site-navbar#close"
      >
        ×
      </button>
    </div>

    <nav class="site-navbar__mobile-navigation">
      <% navigation_pages.each do |page| %>
        <%
          page_path =
            if preview_frame
              preview_path_for.call(page)
            else
              public_path_for.call(page)
            end
        %>

        <%= link_to(
              page.localized_nav_label,
              page_path,
              target: preview_frame ? "_top" : nil,
              class: [
                "site-navbar__mobile-link",
                current_page&.id == page.id ? "is-active" : nil
              ].compact.join(" "),
              data: {
                action: "click->site-navbar#close"
              }
            ) %>
      <% end %>
    </nav>

    <div class="site-navbar__mobile-footer">
      <div class="site-navbar__mobile-languages">
        <%= render "shared/language_control", language: "pt-BR", css_class: "site-navbar__language" %>

        <%= render "shared/language_control", language: "en", css_class: "site-navbar__language" %>
      </div>

      <div class="site-navbar__configured-actions"><%= render "shared/action_buttons", buttons: @site_setting&.header_actions %></div>
    </div>
  </aside>
</header>
