<title><%= seo_title %></title>
<% if seo_description.present? %><meta name="description" content="<%= seo_description %>"><% end %>
<% if @page %>
  <link rel="canonical" href="<%= seo_urls.page(@page) %>">
  <meta property="og:url" content="<%= seo_urls.page(@page) %>">
<% end %>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta property="og:title" content="<%= seo_title %>">
<meta property="og:description" content="<%= seo_description %>">
<meta property="og:site_name" content="<%= @site_setting&.professional_name %>">
<meta property="og:type" content="<%= @page&.editorial? ? 'article' : 'website' %>">
<meta property="og:locale" content="<%= I18n.locale == :en ? 'en_US' : 'pt_BR' %>">
<meta name="twitter:card" content="<%= seo_image_url.present? ? 'summary_large_image' : 'summary' %>">
<% if seo_image_url.present? %><meta property="og:image" content="<%= seo_image_url %>"><% end %>
<%= tag.script(raw(json_escape(seo_structured_data.to_json)), type: "application/ld+json", nonce: content_security_policy_nonce) %>
