<section class="site-section text-image-section text-image-section--<%= section.effective_media_layout %> text-image-section--media-<%= section.effective_media_size %>" id="<%= section.anchor.presence %>">
  <div class="container">
    <div class="text-image-section__layout">
      <div class="text-image-section__copy">
        <% if section.localized_title.present? %>
          <h2 class="section-heading"><%= section.localized_title %></h2>
        <% end %>
        <% if section.localized_body.present? %>
          <div class="section-body"><%= simple_format(section.localized_body) %></div>
        <% end %>
      </div>
      <% if section.image.attached? %>
        <div class="text-image-section__media">
          <div class="text-image-section__media-frame text-image-section__media-frame--<%= section.effective_image_shape %>">
            <%= image_tag section.image, alt: section.localized_title, class: "text-image-section__image", loading: "lazy" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
