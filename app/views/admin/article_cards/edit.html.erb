<div class="admin-section-editor admin-article-card-editor" data-controller="translation" data-translation-url-value="<%= admin_translation_path %>">
  <div class="admin-breadcrumb"><%= link_to 'Blog e textos', admin_articles_path %><span>/</span><%= link_to @article.name, admin_page_sections_path(@article) %><span>/</span><strong>Card em Conteúdos</strong></div>
  <header class="admin-section-editor__heading"><div><span class="admin-page-eyebrow">Apresentação do texto</span><h1>Card em Conteúdos</h1><p>Escolha onde o card aparece e personalize a imagem, o título e o resumo. “Saiba mais” e o clique no card abrem o texto completo.</p></div><%= link_to 'Editar texto completo', admin_page_sections_path(@article), class: 'admin-button-secondary' %></header>
  <div class="article-card-layout">
    <%= simple_form_for @card, as: :article_card, url: admin_article_card_path(@article), method: :patch, html: { class: 'admin-section-editor__form' } do |f| %>
      <%= f.error_notification %>
      <section class="admin-section-editor__panel is-active">
        <div class="admin-section-editor__panel-heading"><span>Card de apresentação</span><h2>Uma prévia do seu texto</h2><p>O resumo pode ser diferente da introdução do artigo. No card, exibimos até 240 caracteres; o conteúdo completo continua no texto.</p></div>
        <div class="input select"><%= label_tag :card_section, 'Seção na página Conteúdos' %><%= select_tag :card_section, options_for_select(@section_options, @section_choice), class: 'form-select', required: true %></div>
        <%= f.input :title, label: 'Título do card', input_html: { data: { translation_target: 'titlePt' } } %>
        <%= f.input :body, label: 'Resumo do card', hint: 'Deixe vazio para mostrar automaticamente um trecho do texto completo.', input_html: { rows: 4, data: { translation_target: 'bodyPt' } } %>
        <details class="admin-optional-fields"><summary>Versão em inglês</summary>
          <button type="button" class="admin-button-secondary" data-translation-target="button" data-action="translation#translate">Traduzir com IA</button>
          <p class="section-translation-feedback" data-translation-target="status" role="status" hidden></p>
          <%= f.input :title_en, label: 'Título do card em inglês', input_html: { data: { translation_target: 'titleEn' } } %>
          <%= f.input :body_en, label: 'Resumo em inglês', input_html: { rows: 4, data: { translation_target: 'bodyEn' } } %>
        </details>
        <% attachment = @card.image.attached? && !@card.image.blob.persisted? ? SectionItem.new.image : @card.image %>
        <%= render 'admin/shared/image_cropper', f: f, record: @card, attachment: attachment, title: 'Imagem do card (opcional)' %>
        <div class="admin-section-editor__input-grid"><%= f.input :position, label: 'Ordem na seção', input_html: { min: 0 } %><%= f.input :visible, as: :boolean, label: 'Exibir card' %></div>
      </section>
      <footer class="admin-section-editor__actions"><%= link_to 'Voltar aos textos', admin_articles_path, class: 'admin-button-quiet' %><%= f.button :submit, 'Salvar card', class: 'admin-button admin-button--primary', data: { turbo_submits_with: 'Salvando…' } %></footer>
    <% end %>
    <aside class="article-card-preview">
      <h2>Prévia do card</h2><p>Salve para atualizar esta prévia. Clique no card para conferir o texto completo.</p>
      <% preview_card = @placement.build %>
      <div class="card-collection" style="--section-title-font: 'Playfair Display', serif; --section-body-font: 'DM Sans', sans-serif; --section-text-align: left"><%= render 'sections/card', item: preview_card %></div>
      <% if @placement.contents_page %><%= link_to 'Pré-visualizar Conteúdos', admin_page_preview_path(@placement.contents_page), class: 'admin-button-secondary' %><% end %>
      <p>Para aparecer no site, publique o texto e a página Conteúdos. As alterações ficam em rascunho até a publicação.</p>
    </aside>
  </div>
</div>
