<section class="site-section text-section">
  <div class="container">

    <% if section.localized_title.present? %>

      <h2 class="section-heading">
        <%= section.localized_title %>
      </h2>

    <% end %>


    <% if section.image.attached? %>

      <%= image_tag section.image,
                    alt:
                      section.localized_title,
                    class: "img-fluid" %>

    <% end %>


    <% if section.localized_body.present? %>

      <div class="section-body">

        <%= simple_format(
              section.localized_body
            ) %>

      </div>

    <% end %>

  </div>
</section>
