<div class="admin-section-editor">
  <div class="admin-breadcrumb"><%= link_to "Páginas", admin_pages_path %><span>/</span><%= link_to @section.title.presence || "Bloco", edit_admin_page_section_path(@page, @section) %></div>
  <header class="admin-section-editor__heading"><div><span class="admin-page-eyebrow">Conteúdo</span><h1><%= @section.title %></h1><p>Edite o conteúdo individual e sua imagem.</p></div><%= link_to "+ Adicionar conteúdo", new_admin_page_section_section_item_path(@page, @section, kind: params[:kind]), class: "admin-button admin-button--primary" %></header>
  <section class="admin-section-editor__panel is-active">
    <nav class="card-content-list__heading">
      <%= link_to "Cards", admin_page_section_section_items_path(@page, @section, kind: "card"), class: "admin-button-secondary" %>
      <% if @section.section_type == "faq" %><%= link_to "Perguntas", admin_page_section_section_items_path(@page, @section, kind: "question"), class: "admin-button-secondary" %><% end %>
      <% if @section.section_type == "gallery" %><%= link_to "Galeria", admin_page_section_section_items_path(@page, @section, kind: "gallery"), class: "admin-button-secondary" %><% end %>
    </nav>
    <% @section_items.each do |item| %>
      <article class="card-content-list__item">
        <% if item.image.attached? %><%= image_tag item.image, alt: "", class: "card-content-list__thumbnail" %><% end %>
        <div><strong><%= item.title %></strong><small><%= item.visible? ? "Visível" : "Oculto" %></small></div>
        <%= link_to "Editar", edit_admin_page_section_section_item_path(@page, @section, item), class: "admin-button-secondary" %>
        <%= link_to "Excluir", admin_page_section_section_item_path(@page, @section, item), class: "admin-button-quiet", data: { turbo_method: :delete, turbo_confirm: "Excluir este conteúdo do rascunho?" } %>
      </article>
    <% end %>
    <% if @section_items.empty? %><p>Adicione o primeiro conteúdo quando quiser.</p><% end %>
  </section>
</div>
