# Nunca inclua senhas reais neste arquivo. Copie os valores para .env.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5-nano

CONTACT_RECIPIENT=contato@example.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_FROM=
# Somente host e porta, sem http://. Em produção, use o domínio real.
APP_HOST=localhost:3000
# Use Redis compartilhado ao implantar mais de um servidor/processo.
RATE_LIMIT_REDIS_URL=

# Produção (no Swarm, as senhas e a master key vêm de Docker Secrets).
APP_TIME_ZONE=America/Sao_Paulo
DB_HOST=localhost
DB_PORT=5432
DB_NAME=psychologist_production
DB_USERNAME=psychologist
DB_PASSWORD=

# local ou cloudinary. Deixe local até configurar as credenciais no .env.
ACTIVE_STORAGE_SERVICE=local
# Copie API Environment Variable no painel Cloudinary (nunca publique o valor).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
