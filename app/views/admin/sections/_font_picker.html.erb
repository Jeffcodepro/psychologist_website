<% selected = f.object.public_send(field); input_id = "#{f.object_name}_#{field}" %>
<div class="font-picker" data-controller="font-picker">
  <%= label_tag input_id, label %>
  <%= f.select field, SectionsHelper::FONT_NAMES.map { |value, name| [name, value, { "data-font-stack" => SectionsHelper::FONT_STACKS[value] }] },
        {}, id: input_id, class: "form-select", data: { font_picker_target: "select", action: "change->font-picker#selectFont" } %>
  <span class="font-picker__sample" data-font-picker-target="sample" style="font-family: <%= SectionsHelper::FONT_STACKS[selected] %>">Aa · Cuidar de você</span>
</div>
