<% english = I18n.locale == :en %>
<%= turbo_frame_tag "contact_form_#{form_section.id}" do %>
  <% if sent %>
    <div class="appointment-form__success" role="status" tabindex="-1">
      <span aria-hidden="true">✓</span><h3><%= english ? "Message received" : "Mensagem recebida" %></h3>
      <p><%= english ? "Thank you for reaching out. I will get back to you using the details provided." : "Obrigada pelo contato. Retornarei pelos dados que você informou." %></p>
    </div>
  <% else %>
    <%= form_with model: contact_request, url: contact_requests_path(locale: I18n.locale), class: "appointment-form" do |f| %>
      <% if contact_request.errors.any? %>
        <div class="appointment-form__errors" role="alert"><strong><%= english ? "Please check your details:" : "Confira seus dados:" %></strong><ul><% contact_request.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
      <% end %>
      <%= hidden_field_tag :form_section_id, form_section.id %>
      <%= hidden_field_tag :source_path, contact_request.source_path.presence || request.path %>
      <div class="appointment-form__honeypot" aria-hidden="true"><%= f.label :website, "Website" %><%= f.text_field :website, tabindex: -1, autocomplete: "off" %></div>
      <div class="contact-fields">
        <% form_section.effective_form_fields.each do |field| %>
          <% field_id = "contact_#{form_section.id}_#{field['key']}"; name = "contact_request[answers][#{field['key']}]"; value = contact_request.answers[field['key']]; label = ContactFormSchema.label(field) %>
          <div class="appointment-form__field contact-fields__<%= field['width'] %>">
            <%= label_tag field_id, "#{label}#{field['required'] ? ' *' : ''}" %>
            <% options = { id: field_id, required: field['required'], maxlength: field['type'] == 'textarea' ? 5000 : 254 } %>
            <% if field['type'] == 'textarea' %><%= text_area_tag name, value, **options, rows: 5 %>
            <% elsif field['type'] == 'select' %><%= select_tag name, options_for_select(field['options'], value), **options.except(:maxlength), include_blank: english ? 'Select' : 'Selecione' %>
            <% elsif field['type'] == 'checkbox' %><%= check_box_tag name, '1', value == '1', **options.except(:maxlength) %>
            <% else %><%= text_field_tag name, value, **options, type: field['type'], autocomplete: { 'email' => 'email', 'tel' => 'tel' }.fetch(field['type'], field['key'] == 'full_name' ? 'name' : 'off') %>
            <% end %>
          </div>
        <% end %>
      </div>
      <p class="appointment-section__note"><%= english ? "Your information will only be used to respond to your request." : "Suas informações serão usadas apenas para responder ao seu contato." %></p>
      <%= f.submit local_assigns[:preview] ? "Prévia do formulário" : (english ? "Request a conversation" : "Quero agendar uma conversa"), class: "appointment-form__submit", disabled: local_assigns[:preview], data: { turbo_submits_with: english ? "Sending…" : "Enviando…" } %>
      <% if local_assigns[:preview] %><small>O envio fica disponível no site.</small><% end %>
    <% end %>
  <% end %>
<% end %>
