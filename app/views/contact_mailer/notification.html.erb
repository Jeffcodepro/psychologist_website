<% brand = @contact.tenant.site_setting&.professional_name.presence || @contact.tenant.name %>
<div style="display:none;font-size:1px;color:#f3f5f2;max-height:0;overflow:hidden;">Uma nova mensagem chegou pelo formulário de <%= brand %>.</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3f5f2;font-family:Arial,Helvetica,sans-serif;color:#263f34;">
  <tr><td align="center" style="padding:32px 12px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:600px;background:#ffffff;border:1px solid #dce5df;border-radius:16px;overflow:hidden;">
      <tr><td style="height:5px;background:#c4a55a;font-size:0;line-height:0;">&nbsp;</td></tr>
      <tr><td style="padding:30px 28px;background:#234539;color:#ffffff;">
        <p style="margin:0 0 16px;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#cbdbd1;"><%= brand %></p>
        <h1 style="margin:0;font-family:Georgia,serif;font-size:30px;font-weight:normal;line-height:1.2;">Um novo contato para você</h1>
        <p style="margin:14px 0 0;font-size:13px;line-height:1.6;color:#d4e2d9;">Mensagem #<%= @contact.id %> · <%= @contact.created_at.in_time_zone.strftime('%d/%m/%Y às %H:%M') %></p>
      </td></tr>
      <tr><td style="padding:28px;">
        <% @contact.response_fields.each_with_index do |(label, value), index| %>
          <% field = @contact.form_snapshot&.[](index)
             display_value = field&.dig('type') == 'checkbox' ? (value == '1' ? 'Sim' : 'Não') : value.presence || 'Não informado' %>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-bottom:1px solid #e7ede8;">
            <tr><td style="padding:0 0 7px;font-size:11px;font-weight:bold;letter-spacing:.6px;text-transform:uppercase;color:#728277;"><%= label %></td></tr>
            <tr><td style="padding:0 0 18px;font-size:16px;line-height:1.65;color:#2d4136;overflow-wrap:anywhere;word-break:break-word;"><%= simple_format(h(display_value.to_s), { style: 'margin:0 0 8px;' }, sanitize: false) %></td></tr>
          </table>
          <div style="height:18px;line-height:18px;font-size:1px;">&nbsp;</div>
        <% end %>
        <% if @contact.email.present? %>
          <table role="presentation" cellspacing="0" cellpadding="0" border="0"><tr><td bgcolor="#2e634a" style="border-radius:8px;">
            <%= link_to 'Responder por e-mail', "mailto:#{@contact.email}", style: 'display:inline-block;padding:14px 24px;border:1px solid #2e634a;border-radius:8px;color:#ffffff;font-size:14px;font-weight:bold;text-decoration:none;' %>
          </td></tr></table>
        <% end %>
      </td></tr>
      <tr><td style="padding:20px 28px;background:#f7f9f6;border-top:1px solid #e3eae4;">
        <p style="margin:0;font-size:12px;line-height:1.7;color:#708075;">Recebido pelo formulário do site. Uma cópia está disponível em Mensagens no painel administrativo.</p>
      </td></tr>
    </table>
    <p style="margin:18px 0 0;font-size:11px;line-height:1.6;color:#869389;"><%= brand %> · Contato pelo site</p>
  </td></tr>
</table>
